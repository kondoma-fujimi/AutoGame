<Window x:Class="AutoGameApprication.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ゲーム操作"
        Width="760"
        Height="332"
        MinWidth="620"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="RoundToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              BorderBrush="Black"
              BorderThickness="1"
              Background="White">
            <MenuItem Header="ファイル">
                <MenuItem Header="設定ファイルを開く..." Click="OpenSettingsMenuItem_Click" />
                <Separator />
                <MenuItem Header="設定ファイルを保存" Click="SaveSettingsMenuItem_Click" />
                <MenuItem Header="名前を付けて保存..." Click="SaveSettingsAsMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="ログ出力..." Click="ShowLogMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.72*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="0.72*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Auto"
                        Click="AutoButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}" />
                <Button Grid.Column="1"
                        Content="Manual"
                        Click="ManualButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}" />
                <Button Grid.Column="2"
                        Content="接続"
                        Click="ConnectButton_Click"
                        Style="{StaticResource RoundToolbarButtonStyle}" />
                <Button Grid.Column="3"
                        Content="Capture"
                        Click="CaptureButton_Click"
                        Style="{StaticResource RoundToolbarButtonStyle}" />
                <Button Grid.Column="4"
                        Content="録画"
                        Click="RecordingButton_Click"
                        Style="{StaticResource RoundToolbarButtonStyle}" />
                <TextBlock x:Name="GameTitleLabel"
                           Grid.Column="5"
                           Text="タイトル未設定"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           FontSize="14" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="Black"
                BorderThickness="0,0,1,1">
            <TextBlock x:Name="StatusText"
                       Text="Control画面 / Autoの設定画面"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Manual COM"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="ComPortComboBox"
                      Grid.Column="1"
                      Margin="4,2"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ComPortComboBox_SelectionChanged" />
            <Button Grid.Column="2"
                    Content="再取得"
                    Margin="2"
                    Padding="4,1"
                    Click="RefreshComPortsButton_Click" />
            <TextBlock Grid.Column="3"
                       Text="映像番号"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="CaptureDeviceComboBox"
                      Grid.Column="4"
                      Margin="4,2"
                      VerticalContentAlignment="Center"
                      SelectionChanged="CaptureDeviceComboBox_SelectionChanged" />
            <TextBlock x:Name="ComPortInfoText"
                       Grid.Column="5"
                       Text="115200 bps / 8N1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>

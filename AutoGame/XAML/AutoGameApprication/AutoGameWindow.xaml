<Window x:Class="AutoGameApprication.AutoGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoGame" Width="437" Height="326"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <RadioButton Content="孵化" Grid.Row="0" VerticalAlignment="Center" />
        <TextBlock Text="孵化させたいポケモン：" Grid.Row="1" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" />
        <TextBlock Text="親1：" Grid.Row="2" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" />
        <TextBlock Text="親1のポケモンがいるボックス" Grid.Row="3" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" />
        <TextBlock Text="親2：" Grid.Row="4" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" />
        <TextBlock Text="親2のポケモンがいるボックス" Grid.Row="5" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" />
        <TextBlock Text="孵化用 / ボックス" Grid.Row="6" VerticalAlignment="Center" />
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
            <TextBox Width="70" Margin="0,2,6,2" />
            <TextBox Width="70" Margin="0,2" />
        </StackPanel>
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="欲しい数" VerticalAlignment="Center" />
            <TextBox Width="70" Margin="8,2,20,2" />
            <TextBlock Text="ゲット数" VerticalAlignment="Center" />
            <TextBox Width="70" Margin="8,2" />
            <Button Content="画像から検索" Margin="8,2" Padding="8,2" />
        </StackPanel>
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Start" Width="90" Margin="4,0" />
            <Button Content="End" Width="90" Margin="4,0" />
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="AutoGameApprication.ComPortSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMポート選択"
        Width="390"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,4"
                Background="#FFE4C2"
                BorderBrush="#D68A00"
                BorderThickness="1">
            <TextBlock Text="Manualコントローラー用のCOMポートを選択してください"
                       VerticalAlignment="Center"
                       FontSize="13" />
        </Border>

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="#FFE4C2"
                    BorderBrush="#D68A00"
                    BorderThickness="1"
                    Padding="8,4">
                <TextBlock Text="COM:"
                           VerticalAlignment="Center"
                           FontSize="13" />
            </Border>
            <ComboBox x:Name="ComPortComboBox"
                      Grid.Column="1"
                      Margin="0,0,0,0"
                      Background="#D8EAD5"
                      BorderBrush="#87A982"
                      BorderThickness="1"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ComPortComboBox_SelectionChanged" />
        </Grid>

        <TextBlock x:Name="PortStatusText"
                   Grid.Row="2"
                   Margin="4,6"
                   Foreground="#555555"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="再取得"
                    Click="RefreshButton_Click"
                    MinWidth="72"
                    Margin="4,0"
                    Padding="8,4" />
            <Button x:Name="CreateButton"
                    Content="作成"
                    Click="CreateButton_Click"
                    IsEnabled="False"
                    MinWidth="82"
                    Margin="4,0"
                    Padding="10,4" />
            <Button Content="キャンセル"
                    IsCancel="True"
                    MinWidth="82"
                    Margin="4,0"
                    Padding="10,4" />
        </StackPanel>
    </Grid>
</Window>

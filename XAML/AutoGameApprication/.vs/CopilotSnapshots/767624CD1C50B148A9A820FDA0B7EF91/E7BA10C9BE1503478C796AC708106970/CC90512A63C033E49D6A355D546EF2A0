<Window x:Class="AutoGameApprication.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoGame Menu"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Grid>
        <Border x:Name="DeviceShell"
                Margin="18"
                Background="#E84F5F"
                CornerRadius="70"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="OpenScale" ScaleX="0.18" ScaleY="0.18" />
            </Border.RenderTransform>

            <Grid Margin="34,42,34,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,28"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="AutoGame" />

                <Border Grid.Row="1"
                        Padding="18"
                        Background="#F7F7F7"
                        CornerRadius="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Margin="8"
                                Click="GameButton_Click"
                                Content="Game"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#333333"
                                BorderThickness="0"
                                Cursor="Hand" />

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Margin="8"
                                Click="NotImplementedButton_Click"
                                Tag="Custom"
                                Content="Custom"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#555555"
                                BorderThickness="0"
                                Cursor="Hand" />

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Margin="8"
                                Click="NotImplementedButton_Click"
                                Tag="図鑑"
                                Content="図鑑"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#555555"
                                BorderThickness="0"
                                Cursor="Hand" />

                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Margin="8"
                                Click="NotImplementedButton_Click"
                                Tag="計算"
                                Content="計算"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#555555"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           Text="メニューを選択してください" />
            </Grid>
        </Border>
    </Grid>
</Window>
